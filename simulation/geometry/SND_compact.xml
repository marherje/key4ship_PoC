<lccdd xmlns:compact="http://www.lcsim.org/schemas/compact/1.0"
       xmlns:xs="http://www.w3.org/2001/XMLSchema"
       xs:noNamespaceSchemaLocation="http://www.lcsim.org/schemas/compact/1.0/compact.xsd">

  <info name="SND_sim_poc" title="SND simulation proof-of-concept" author="J.P. Marquez"
        url="" status="development" version="1.0">
    <comment> key4hep 2026-02-01 compatible </comment>
  </info>

  <includes>
    <gdmlFile ref="elements.xml"/>
    <gdmlFile ref="materials.xml"/>
  </includes>

  <define>
    <!-- Detector type flag constants from DD4hep DetType.h -->
    <!-- These are needed by ACTS convertDD4hepDetector to classify subdetectors -->
    <!-- <constant name="DetType_TRACKER"  value="0x1"/> -->
    <!-- <constant name="DetType_BARREL"   value="0x10"/> -->
    <!-- <constant name="DetType_STRIP"    value="0x80"/> -->
    <!-- <constant name="DetType_PIXEL"    value="0x100"/> -->

    <!-- World -->
    <constant name="world_side" value="20*m"/>
    <constant name="world_x"    value="world_side"/>
    <constant name="world_y"    value="world_side"/>
    <constant name="world_z"    value="world_side"/>
    <constant name="env_safety"               value="0.001*mm"/>

    <!-- Required by DD4hep tracking region -->
    <constant name="tracker_region_rmax" value="0*mm"/>
    <constant name="tracker_region_zmax" value="0*mm"/>

    <!-- Input parameters -->
    <constant name="SiPad_WThickness"        value="10*mm"/>
    <constant name="SiTarget_WThickness"     value="3.5*mm"/>
    <constant name="SiPad_dim_z"              value="370*mm"/>


    <!-- Directly derived parameters -->
    <constant name="SiTarget_dim_z"          value="1700*mm-SiPad_dim_z"/>
    <constant name="SiTarget_z_position"     value="-SiTarget_dim_z/2.0-SiPad_dim_z"/>

    <!-- ECAL geometry constants (from SiPad_commondefs.xml) -->
    <constant name="SiPad_z_position"         value="-SiPad_dim_z/2.0"/>

    <!-- Transverse tiling: 3x3 ASUs, each ASU a 2x2 array of silicon sensors,
         i.e. 6x6 wafers per sensitive plane. Three length scales, measured on
         the real sensor:
           * the active diode      SiPad_PadSizeX   = 5.52 mm
           * the inter-pad margin  SiPad_PadMarginX = 0.01 mm
           * the pixel pitch       SiPad_CellSizeX  = 5.53 mm (sum of the two)
         so 16 pixels span SiPad_WaferActiveX = 88.48 mm. The sensor itself
         carries an inactive rim SiPad_WaferMarginX = 0.61 mm all round, giving
         a physical sensor of 88.48 + 2*0.61 = 89.70 mm.

         The 0.01 mm inter-pad margin is silicon belonging to no diode; it is
         far below any Geant4 step length and is not modelled as a volume: the
         pad array is one sensitive block that the segmentation tiles at the
         5.53 mm pitch. The 0.61 mm rim IS modelled, as a non-sensitive silicon
         frame around that block (see SiPadDetector.cpp). -->
    <constant name="SiPad_PadSizeX"           value="5.52*mm"/>
    <constant name="SiPad_PadSizeY"           value="5.52*mm"/>
    <constant name="SiPad_PadMarginX"         value="0.01*mm"/>
    <constant name="SiPad_PadMarginY"         value="0.01*mm"/>
    <!-- Pixel pitch: what the readout segmentation tiles the sensor with. -->
    <constant name="SiPad_CellSizeX"          value="SiPad_PadSizeX+SiPad_PadMarginX"/>
    <constant name="SiPad_CellSizeY"          value="SiPad_PadSizeY+SiPad_PadMarginY"/>
    <constant name="SiPad_NPadsPerWaferX"     value="16"/>
    <constant name="SiPad_NPadsPerWaferY"     value="16"/>
    <constant name="SiPad_WaferMarginX"       value="0.61*mm"/>
    <constant name="SiPad_WaferMarginY"       value="0.61*mm"/>
    <!-- Sensitive pad array, and the physical sensor that holds it. -->
    <constant name="SiPad_WaferActiveX"       value="SiPad_NPadsPerWaferX*SiPad_CellSizeX"/>
    <constant name="SiPad_WaferActiveY"       value="SiPad_NPadsPerWaferY*SiPad_CellSizeY"/>
    <constant name="SiPad_WaferSizeX"         value="SiPad_WaferActiveX+2*SiPad_WaferMarginX"/>
    <constant name="SiPad_WaferSizeY"         value="SiPad_WaferActiveY+2*SiPad_WaferMarginY"/>
    <!-- Wafers per ASU, per side. The sensors are butted, so the extra
         clearance is zero and the dead cross inside an ASU is exactly
         2*SiPad_WaferMarginX = 1.22 mm. -->
    <constant name="SiPad_NWafersX"           value="2"/>
    <constant name="SiPad_NWafersY"           value="2"/>
    <constant name="SiPad_WaferGapX"          value="0*mm"/>
    <constant name="SiPad_WaferGapY"          value="0*mm"/>
    <!-- ASUs tiled per plane. One ASU is 180 mm while its wafers span
         2*89.70 = 179.4 mm, leaving 0.3 mm of inactive border per side, so
         butting ASUs at this pitch gives a 2*(0.3+0.61) = 1.82 mm dead region
         between sensors of adjacent ASUs. Changing NASUs* requires
         regenerating the SiPadHits readout below:
             python3 simulation/geometry/make_readout.py <NASUsX> <NASUsY>  -->
    <constant name="SiPad_NASUsX"             value="3"/>
    <constant name="SiPad_NASUsY"             value="3"/>
    <constant name="SiPad_ASUPitchX"          value="180*mm"/>
    <constant name="SiPad_ASUPitchY"          value="180*mm"/>
    <constant name="SiPad_NcellsX"            value="SiPad_NASUsX*SiPad_NWafersX*SiPad_NPadsPerWaferX"/>
    <constant name="SiPad_NcellsY"            value="SiPad_NASUsY*SiPad_NWafersY*SiPad_NPadsPerWaferY"/>
    <constant name="SiPad_dim_x"              value="SiPad_NASUsX*SiPad_ASUPitchX"/>
    <constant name="SiPad_dim_y"              value="SiPad_NASUsY*SiPad_ASUPitchY"/>
    <!-- Segmentation offset of the first wafer column/row. The grid is local to
         the sensitive pad array of a wafer (5.53 mm pitch, 16 pads, so the
         offset is measured from SiPad_WaferActiveX and NOT from the physical
         sensor size); the readout block shifts this offset by a whole pad array
         per column/row so the x/y indices come out as the GLOBAL pad indices
         across the plane (0..95 for 3x3 ASUs). -->
    <constant name="SiPad_SegOffsetX0"        value="-(SiPad_WaferActiveX-SiPad_CellSizeX)/2.0"/>
    <constant name="SiPad_SegOffsetY0"        value="-(SiPad_WaferActiveY-SiPad_CellSizeY)/2.0"/>

    <constant name="SiPad_CFThickness"        value="1.5*mm"/>
    <constant name="SiPad_KaptonThickness"    value="0.1*mm"/>
    <constant name="SiPad_GlueThickness_kap"  value="0.1*mm"/>
    <constant name="SiPad_GlueThickness_pcb"  value="0.1*mm"/>
    <constant name="SiPad_WaferThickness650"  value="0.65*mm"/>
    <constant name="SiPad_PcbThickness"       value="1.7*mm"/>
    <constant name="SiPad_ChipThickness"      value="1.2*mm"/>
    <constant name="SiPad_layer_gap"         value="1*mm"/>
    <constant name="SiPad_LayerThickness"      value="SiPad_WThickness+SiPad_layer_gap+SiPad_CFThickness+SiPad_KaptonThickness+SiPad_GlueThickness_kap+SiPad_WaferThickness650+SiPad_GlueThickness_pcb+SiPad_KaptonThickness+SiPad_PcbThickness+SiPad_ChipThickness"/>
    <constant name="SiPad_NLayers"            value="floor(SiPad_dim_z/SiPad_LayerThickness)"/>

    <!-- SiTarget constants (from FairShip SiliconTarget_config.yaml) -->
    <constant name="SiTarget_strip_pitch"    value="0.0755*mm"/>
    <constant name="SiTarget_module_offset"  value="1*mm"/> <!-- From W to Si planes -->
    <constant name="SiTarget_spacing"         value="11.0*mm"/> <!-- Between W planes -->
    <constant name="SiTarget_sensor_thickness" value="0.3*mm"/>
    <constant name="SiTarget_XY_plane_gap" value="SiTarget_spacing-SiTarget_WThickness-2*SiTarget_module_offset-2*SiTarget_sensor_thickness"/>
    <constant name="SiTarget_env_width"      value="400*mm"/>
    <constant name="SiTarget_env_height"     value="400*mm"/>
    <constant name="SiTarget_LayerThickness"      value="SiTarget_spacing"/>
    <!-- SiTarget sensor layout: 4 columns x 2 rows per plane (square sensors) -->
    <constant name="SiTarget_sensor_width"    value="99.25*mm"/>  <!-- active X -->
    <constant name="SiTarget_sensor_height"   value="199.5*mm"/>  <!-- active Y -->
    <constant name="SiTarget_sensor_gap"      value="1.0*mm"/>    <!-- gap between sensors -->
    <constant name="SiTarget_ncols"           value="4"/>
    <constant name="SiTarget_nrows"           value="2"/>
    <constant name="SiTarget_NLayers"       value="floor(SiTarget_dim_z/SiTarget_LayerThickness)"/>

    <!-- MTC shared layer constants (hardcoded values from MTCDetector.h unless noted) -->
    <constant name="MTC_FeThickness"         value="50.0*mm"/>  <!-- outer iron absorber, PoC default -->
    <constant name="MTC_InnerIronThickness"  value="3.0*mm"/>   <!-- lowerIronThick = upperIronThick -->
    <constant name="MTC_SciFiThickness"      value="1.35*mm"/>  <!-- fiberMatThick per plane -->
    <constant name="MTC_XY_plane_gap"        value="1.0*mm"/>   <!-- airGap between U and V planes -->
    <constant name="MTC_ScintThickness"      value="15.0*mm"/>
    <constant name="MTC_layer_gap"           value="1.0*mm"/>
    <constant name="MTC_NLayers"             value="14"/>
    <constant name="MTC_fiber_angle_deg"     value="5"/>        <!-- dimensionless degrees, converted in plugin -->
    <constant name="MTC_ScintCellSize"       value="50.0*mm"/>
    <constant name="MTC_SciFiChannelSize"    value="1.0*mm"/>   <!-- PoC placeholder, tune later -->
    <constant name="MTC_max_env_width"       value="600.0*mm"/>

    <constant name="MTC_layer_thickness" value="MTC_FeThickness + MTC_InnerIronThickness + MTC_SciFiThickness + MTC_XY_plane_gap + MTC_SciFiThickness + MTC_InnerIronThickness + MTC_ScintThickness + MTC_layer_gap"/>
    <constant name="MTC_total_length"    value="MTC_NLayers * MTC_layer_thickness"/>

    <!-- Per-station transverse dimensions -->
    <constant name="MTC40_env_width"     value="600.0*mm"/>
    <constant name="MTC40_env_height"    value="600.0*mm"/>
    <constant name="MTC50_env_width"     value="600.0*mm"/>
    <constant name="MTC50_env_height"    value="600.0*mm"/>
    <constant name="MTC60_env_width"     value="600.0*mm"/>
    <constant name="MTC60_env_height"    value="600.0*mm"/>

    <!-- Width of the magnetic iron core inside the 50 mm absorber (slice 0);
         the remaining transverse footprint is filled with (non-magnetic) Steel -->
    <constant name="MTC40_iron_width" value="400.0*mm"/>
    <constant name="MTC50_iron_width" value="500.0*mm"/>
    <constant name="MTC60_iron_width" value="600.0*mm"/>

    <!-- Z centres: gap of 600 mm after SiPad downstream face, stations back-to-back.
         MTC_inter_station_gap avoids the envelope overlap from the plugin's
         (now correctly-converted, 0.001 mm) safety margin. -->
    <constant name="MTC_inter_station_gap" value="1.0*mm"/>
    <constant name="MTC40_z_position"    value="MTC_total_length/2.0 + MTC_inter_station_gap"/>
    <constant name="MTC50_z_position"    value="MTC40_z_position + MTC_total_length + MTC_inter_station_gap"/>
    <constant name="MTC60_z_position"    value="MTC50_z_position + MTC_total_length + MTC_inter_station_gap"/>

    <!-- Magnetic field in MTC outer iron absorbers -->
    <constant name="MTC_BFieldY" value="1.7*tesla"/>
  </define>

  <limits>
    <limitset name="cal_limits">
      <limit name="step_length_max" particles="*" value="3.0" unit="mm"/>
    </limitset>
  </limits>

  <display>
    <vis name="Invisible"    alpha="0.0" r="0"   g="0"    b="0"    showDaughters="false" visible="false"/>
    <!-- Container volumes (MTC station envelopes, layers): not drawn themselves
         but their contents are. Without this entry the plugin's
         setVisAttributes() call silently does nothing. -->
    <vis name="InvisibleWithDaughters" alpha="0.0" r="0"   g="0"    b="0"    showDaughters="true"  visible="false"/>
    <vis name="SteelVis"     alpha="1.0" r="0.15" g="0.75" b="0.35" showDaughters="true"  visible="true"/>
    <vis name="EcalVis"      alpha="0.1" r="0.7" g="0.7"  b="0.0"  showDaughters="true"  visible="false"/>
    <vis name="TungstenVis"  alpha="0.5" r="0.5" g="0.35" b="0.55" showDaughters="true"  visible="true"/>
    <vis name="AirVis"       alpha="0.01" r="1.0" g="1.0"  b="1.0"  showDaughters="true"  visible="false"/>
    <vis name="SiVis"        alpha="0.5" r="0.9" g="0.9"  b="0.9"  showDaughters="true"  visible="true"/>
    <vis name="AlVis"        alpha="0.9" r="0.3" g="0.6"  b="0.9"  showDaughters="true"  visible="true"/>
    <vis name="BaseVis"      alpha="0.3" r="0.9" g="0.8"  b="0.4"  showDaughters="true"  visible="true"/>
    <vis name="PCBVis"       alpha="0.1" r="0.0" g="0.8"  b="0.0"  showDaughters="true"  visible="true"/>
    <vis name="CFVis"        alpha="0.1" r="0.0" g="0.0"  b="0.0"  showDaughters="true"  visible="false"/>
    <vis name="CuVis"        alpha="0.1" r="1.0" g="0.5"  b="0.0"  showDaughters="true"  visible="false"/>
  </display>

  <readouts>
    <!-- 3x3 ASUs = 6x6 wafers = 96x96 pads. Generated by make_readout.py, do not edit by hand. -->
    <readout name="SiPadHits">
      <segmentation type="MultiSegmentation" key="wafer">
        <segmentation name="wafer0" type="TiledLayerGridXY" key_value="0"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0"
                      offset_y="SiPad_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer1" type="TiledLayerGridXY" key_value="1"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-1*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer2" type="TiledLayerGridXY" key_value="2"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-2*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer3" type="TiledLayerGridXY" key_value="3"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-3*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer4" type="TiledLayerGridXY" key_value="4"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-4*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer5" type="TiledLayerGridXY" key_value="5"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-5*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer6" type="TiledLayerGridXY" key_value="6"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0"
                      offset_y="SiPad_SegOffsetY0-1*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer7" type="TiledLayerGridXY" key_value="7"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-1*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-1*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer8" type="TiledLayerGridXY" key_value="8"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-2*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-1*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer9" type="TiledLayerGridXY" key_value="9"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-3*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-1*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer10" type="TiledLayerGridXY" key_value="10"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-4*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-1*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer11" type="TiledLayerGridXY" key_value="11"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-5*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-1*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer12" type="TiledLayerGridXY" key_value="12"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0"
                      offset_y="SiPad_SegOffsetY0-2*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer13" type="TiledLayerGridXY" key_value="13"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-1*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-2*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer14" type="TiledLayerGridXY" key_value="14"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-2*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-2*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer15" type="TiledLayerGridXY" key_value="15"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-3*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-2*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer16" type="TiledLayerGridXY" key_value="16"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-4*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-2*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer17" type="TiledLayerGridXY" key_value="17"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-5*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-2*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer18" type="TiledLayerGridXY" key_value="18"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0"
                      offset_y="SiPad_SegOffsetY0-3*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer19" type="TiledLayerGridXY" key_value="19"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-1*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-3*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer20" type="TiledLayerGridXY" key_value="20"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-2*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-3*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer21" type="TiledLayerGridXY" key_value="21"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-3*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-3*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer22" type="TiledLayerGridXY" key_value="22"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-4*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-3*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer23" type="TiledLayerGridXY" key_value="23"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-5*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-3*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer24" type="TiledLayerGridXY" key_value="24"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0"
                      offset_y="SiPad_SegOffsetY0-4*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer25" type="TiledLayerGridXY" key_value="25"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-1*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-4*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer26" type="TiledLayerGridXY" key_value="26"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-2*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-4*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer27" type="TiledLayerGridXY" key_value="27"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-3*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-4*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer28" type="TiledLayerGridXY" key_value="28"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-4*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-4*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer29" type="TiledLayerGridXY" key_value="29"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-5*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-4*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer30" type="TiledLayerGridXY" key_value="30"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0"
                      offset_y="SiPad_SegOffsetY0-5*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer31" type="TiledLayerGridXY" key_value="31"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-1*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-5*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer32" type="TiledLayerGridXY" key_value="32"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-2*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-5*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer33" type="TiledLayerGridXY" key_value="33"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-3*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-5*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer34" type="TiledLayerGridXY" key_value="34"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-4*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-5*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer35" type="TiledLayerGridXY" key_value="35"
                      grid_size_x="SiPad_CellSizeX" grid_size_y="SiPad_CellSizeY"
                      offset_x="SiPad_SegOffsetX0-5*SiPad_NPadsPerWaferX*SiPad_CellSizeX"
                      offset_y="SiPad_SegOffsetY0-5*SiPad_NPadsPerWaferY*SiPad_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
      </segmentation>
      <id>system:8,layer:8,slice:4,x:9,y:9,wafer:6</id>
    </readout>

    <!-- MTC unified readout: plane=0 (SciFi U), plane=1 (SciFi V), plane=2 (Scint).
         CartesianStripX writes to 'strip'; CartesianGridXY writes to 'x','y'.
         For SciFi hits: strip=channel, x=0, y=0.
         For Scint hits: strip=0, x=cell_x, y=cell_y.
         Downstream split happens in EventShuffler based on the plane field. -->
    <readout name="MTCDetHits">
      <segmentation type="MultiSegmentation" key="plane">
        <segmentation type="CartesianStripXStereo"
                      key_value="0"
                      strip_size_x="MTC_SciFiChannelSize"
                      offset_x="-(MTC_max_env_width/2.0)+0.001*mm"
                      stereo_angle="5.0"/>
        <segmentation type="CartesianStripXStereo"
                      key_value="1"
                      strip_size_x="MTC_SciFiChannelSize"
                      offset_x="-(MTC_max_env_width/2.0)+0.001*mm"
                      stereo_angle="-5.0"/>
        <segmentation type="CartesianGridXY"
                      key_value="2"
                      grid_size_x="MTC_ScintCellSize"
                      grid_size_y="MTC_ScintCellSize"
                      offset_x="-(MTC_max_env_width/2.0)+0.001*mm"
                      offset_y="-(MTC_max_env_width/2.0)+0.001*mm"/>
      </segmentation>
      <!-- plane:2 = 2 bits for values 0,1,2; strip for SciFi; x,y for Scint -->
      <id>system:8,station:2,layer:8,slice:4,plane:2,strip:14,x:9,y:9</id>
    </readout>

    <readout name="SiTargetHits">
      <!-- MultiSegmentation selects strip direction based on plane field:
           plane=0 → CartesianStripX (measures X coordinate)
           plane=1 → CartesianStripY (measures Y coordinate)
           column: 0-3 (4 columns in X), row: 0-1 (2 rows in Y)
           strip: strip index within the sensor (up to 1298 strips) -->
      <segmentation type="MultiSegmentation" key="plane">
        <segmentation type="CartesianStripX"
                      key_value="0"
                      strip_size_x="SiTarget_strip_pitch"
                      offset_x="-(SiTarget_env_width/2.0)+0.001*mm"/>
        <segmentation type="CartesianStripY"
                      key_value="1"
                      strip_size_x="SiTarget_strip_pitch"
                      offset_x="-(SiTarget_env_height/2.0)+0.001*mm"/>
      </segmentation>
      <id>system:8,layer:8,slice:4,plane:1,column:2,row:2,strip:14</id>
    </readout>
  </readouts>

  <detectors>
    <include ref="SiPadDetector.xml"/>
    <include ref="SiTarget.xml"/>
    <include ref="MTCDetector.xml"/>
  </detectors>


</lccdd>
