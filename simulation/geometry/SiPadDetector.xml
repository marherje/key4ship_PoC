<detector name="SiPad" type="SiPadDetector" vis="EcalVis" id="1"
          readout="SiPadHits" insideTrackingVolume="false">

  <dimensions x="SiPad_dim_x" y="SiPad_dim_y" z="SiPad_dim_z"/>

  <type_flags type="DetType_TRACKER + DetType_BARREL + DetType_PIXEL"/>

  <!-- Wafer layout of every sensitive slice: asus_x * asus_y ASUs on a fixed
       pitch, each ASU holding wafers_x * wafers_y silicon sensors of
       wafer_size_x * wafer_size_y. Each sensor is silicon throughout, but only
       the central part is a diode: margin_x / margin_y is the inactive rim, so
       the sensitive area is wafer_size - 2*margin. The sensitive part carries
       the 'wafer' physVolID, numbered globally across the plane.

       Everything else is dead: the rim, the optional extra clearance gap_x /
       gap_y between two sensors, the space between ASUs and the outer border
       of the plane, all filled with the non-sensitive 'gap_material'.
       Particles crossing any of them produce no hit. -->
  <tiling asus_x="SiPad_NASUsX"           asus_y="SiPad_NASUsY"
          asu_pitch_x="SiPad_ASUPitchX"   asu_pitch_y="SiPad_ASUPitchY"
          wafers_x="SiPad_NWafersX"       wafers_y="SiPad_NWafersY"
          wafer_size_x="SiPad_WaferSizeX" wafer_size_y="SiPad_WaferSizeY"
          margin_x="SiPad_WaferMarginX"   margin_y="SiPad_WaferMarginY"
          gap_x="SiPad_WaferGapX"         gap_y="SiPad_WaferGapY"
          gap_material="Air"/>

  <envelope vis="EcalVis">
    <shape type="Box"
           dx="SiPad_dim_x/2.0 + env_safety"
           dy="SiPad_dim_y/2.0 + env_safety"
           dz="SiPad_dim_z/2.0 + env_safety"
           material="Air"/>
    <rotation x="0" y="0" z="0"/>
    <position x="0" y="0" z="SiPad_z_position"/>
  </envelope>

  <!-- Layers 2-4: W(1.40x) + W(4.20x) + air + CF + Cu + glue + Si(650um) + glue + Cu + PCB + chip + gap

       SiPad_frame_gap is the air between the absorber and the carbon frame,
       and SiPad_layer_gap the one closing the layer, from the chip to the W of
       the next one. The plugin packs the layers contiguously and centres them
       in the envelope, so it is the second of the two that takes up whatever
       SiPad_dim_z is left over by the material budget: config.py sizes it
       (SiPad_layer_gap: auto) so that NLayers layers span dim_z exactly and
       the sensitive planes come out equidistant. When it is not
       needed it shrinks to 1e-6 mm rather than to zero: the slice has to stay
       in the geometry, both because Geant4 rejects a box of null extent and
       because the index of the sensitive slice behind it would shift. -->
  <layer repeat="SiPad_NLayers" vis="EcalVis">
    <slice material="TungstenDens1910" thickness="SiPad_WThickness"   vis="TungstenVis"/>
    <slice material="Air"             thickness="SiPad_frame_gap"          vis="AirVis"/>
    <slice material="CarbonFiber"     thickness="SiPad_CFThickness"        vis="CFVis"/>
    <slice material="Copper"          thickness="SiPad_KaptonThickness"    vis="CuVis"/>
    <slice material="Air"             thickness="SiPad_GlueThickness_kap"  vis="AirVis"/>
    <slice material="Silicon"         thickness="SiPad_WaferThickness650"  vis="SiVis" sensitive="yes"/>
    <slice material="Air"             thickness="SiPad_GlueThickness_pcb"  vis="AirVis"/>
    <slice material="Copper"          thickness="SiPad_KaptonThickness"    vis="CuVis"/>
    <slice material="PCB"             thickness="SiPad_PcbThickness"       vis="PCBVis"/>
    <slice material="Air"             thickness="SiPad_ChipThickness"      vis="AirVis"/>
    <slice material="Air"             thickness="SiPad_layer_gap"         vis="AirVis"/>
  </layer>

</detector>
